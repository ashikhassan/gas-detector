# Server Configuration
PORT=3000

# Meta WhatsApp Cloud API Configuration
WHATSAPP_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
RECIPIENT_PHONE=8801XXXXXXXXX
GRAPH_API_VERSION=v23.0
ALERT_TEMPLATE_NAME=gas_alert
RECOVERY_TEMPLATE_NAME=gas_recovered

# Default Alarm Threshold (ESP32 analog scale: 0-4095)
GAS_THRESHOLD=2000

# Webhook verify token (set same value in Meta App > WhatsApp > Configuration)
WHATSAPP_VERIFY_TOKEN=change-me
